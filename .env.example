# Required: replace with a long, unique password. Never commit your .env file.
PROXY_PASSWORD=
# Set true when serving through HTTPS (including an HTTPS reverse proxy).
AUTH_COOKIE_SECURE=false
# Public browser URL, e.g. https://proxy.example.com (include a non-default port).
# Set this behind a reverse proxy. HTTPS automatically enables Secure cookies.
PUBLIC_ORIGIN=
